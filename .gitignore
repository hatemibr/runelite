# Boot scratch: the game cache this fetches, the redirected output of a run, and the
# screenshots taken of it. All reproducible by running it again.
/.cache/
/.tools/
/boot_out.txt
/boot_err.txt
/boot_pid.txt
/*.png
/*.txt

# The isolated RuneLite home a local run is pointed at, so a test session cannot disturb
# the real one. Holds that session's profile, its installed plugins and its logs.
/.home/

# Game data the client writes or unpacks beside itself when run from here. Large, binary,
# and rebuilt from the cache on demand -- none of it belongs to this repository.
/cache/
/textures/

# Scratch file for composing commit messages without a BOM.
/.commitmsg
